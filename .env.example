# =========================================================================
# BHOOMI INTELLIGENCE 2.0 — ENVIRONMENT CONFIGURATION
# AI-Powered Multi-Resolution Agricultural Intelligence & Drone Surveillance
# =========================================================================

# --- BACKEND SERVER CONFIGURATION ---
PORT=5001
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# --- DATABASE CONFIGURATION ---
# Primary: PostgreSQL with PostGIS extension enabled
DATABASE_URL=postgres://postgres:your_password@localhost:5432/bhoomi_os
# Resilient Fallback: If PostgreSQL is unreachable, the system automatically 
# engages an embedded zero-latency SQLite spatial store with PostGIS-equivalent functions.

# --- GEOSPATIAL & SATELLITE (SENTINEL-2 / COPERNICUS) ---
# Copernicus Data Space Ecosystem (CDSE) credentials for live Sentinel-2 MSI ingestion
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret
# Optional Google Earth Engine service account
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=

# --- WEATHER INTELLIGENCE ---
# Open-Meteo API endpoint (compliant User-Agent automatically attached by backend)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- AI & DRONE COMPUTER VISION MICROSERVICE ---
PYTHON_AI_SERVICE_URL=http://localhost:8000
# OpenDroneMap / WebODM API endpoint for photogrammetry reconstruction
OPENDRONEMAP_URL=http://localhost:3000
OPENDRONEMAP_TOKEN=your_odm_token

# --- DRONE PLANNING DEFAULTS ---
DEFAULT_DRONE_ALTITUDE_M=60.0
DEFAULT_SIDE_OVERLAP_PCT=70.0
DEFAULT_FORWARD_OVERLAP_PCT=80.0
DEFAULT_DAILY_DRONE_CAPACITY=45

# --- AGRISTACK / UFSI INTEGRATION (SANDBOX) ---
AGRISTACK_SANDBOX_URL=https://sandbox.agristack.gov.in
